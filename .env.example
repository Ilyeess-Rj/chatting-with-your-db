# ============================================================
# Chatting with Your DB - environment template
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit the real .env file (it is listed in .gitignore).
#
# NOTE: LLM / Telegram / Gemini API keys are NOT stored here.
# They live inside n8n as encrypted Credentials (see README).
# ============================================================

# --- MongoDB (used by docker-compose.yml) -----------------------
# Root account: administration only, never used by n8n.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-password

# Database and collection used by the bot.
MONGO_DB_NAME=stock_db

# Least-privilege account (readWrite on MONGO_DB_NAME only).
# This is the account you enter in the n8n MongoDB credential.
MONGO_APP_USER=n8n_app
MONGO_APP_PASSWORD=change-me-to-another-long-random-password

# --- n8n --------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Public HTTPS URL Telegram uses to reach n8n (webhook).
# Local development: use a tunnel (ngrok / cloudflared) and paste its https URL.
# Must end with a trailing slash.
WEBHOOK_URL=https://your-public-domain.example/

# Encrypts credentials stored by n8n. Generate once and keep it safe:
#   openssl rand -hex 32
# If you lose it, saved credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

GENERIC_TIMEZONE=Africa/Tunis
